{
  "expo": {
    "name": "Symponia",
    "slug": "symponia",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "symponia",
    "icon": "./Assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.symponia.app",
      "buildNumber": "34",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Symponia would like to send you a daily reflection — a short, centering thought for your morning.",
        "NSMicrophoneUsageDescription": "Symponia listens to your voice so you can speak your questions.",
        "NSSpeechRecognitionUsageDescription": "Symponia transcribes your voice to text.",
        "NSPhotoLibraryUsageDescription": "Symponia does not access your photo library."
      }
    },
    "android": {
      "icon": "./Assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./Assets/images/icon.png",
        "backgroundColor": "#0C1014"
      },
      "package": "com.symponia.app"
    },
    "web": {
      "favicon": "./Assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./Assets/images/icon.png",
          "color": "#0C1014"
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.51163397268-8cu8dbbqk3pjblrvm7lqiu12j9e4kpm6"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Symponia listens to your voice so you can speak your questions."
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Symponia listens to your voice so you can speak your questions.",
          "speechRecognitionPermission": "Symponia transcribes your voice to text."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./Assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#EDF5F5",
          "imageWidth": 180
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8dcbb94-7850-4283-9bce-550979a54dbf"
      },
      "googleIosClientId": "51163397268-8cu8dbbqk3pjblrvm7lqiu12j9e4kpm6.apps.googleusercontent.com",
      "googleWebClientId": "51163397268-sfj41f6r88ss5niljntq1s2116b1stat.apps.googleusercontent.com"
    },
    "updates": {
      "url": "https://u.expo.dev/f8dcbb94-7850-4283-9bce-550979a54dbf",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
